# All optional. Site runs in preview mode without these.

# Contract addresses (0x...) — minting stays disabled until Gen 1 is set.
NEXT_PUBLIC_GEN1_CONTRACT=
# Gen 1 falls back to the deployed Gary Ghosts contract when left empty:
# 0x396b3e128bb62a71813f4ef42bbe66ed2cc657df
NEXT_PUBLIC_GEN2_CONTRACT=0x44fc0be497a6e882aa2c6751315e888df37bace6

# 1 = Ethereum mainnet, 11155111 = Sepolia
NEXT_PUBLIC_CHAIN_ID=1

# Fallback only — the mint panel reads GHOST_PRICE from the contract.
NEXT_PUBLIC_GEN1_PRICE_ETH=0.05

# V2 launches December 22, 2026 at 8:00 AM CST (14:00 UTC)
NEXT_PUBLIC_GEN2_MINT_DATE=2026-12-22T14:00:00.000Z

# Optional: enables the WalletConnect connector
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_LINK_X=https://x.com/GoldiesNFTart
NEXT_PUBLIC_LINK_DISCORD=https://discord.com
NEXT_PUBLIC_LINK_OPENSEA=https://opensea.io/collection/gary-ghosts
NEXT_PUBLIC_LINK_OPENSEA_V2=https://opensea.io/collection/gary-ghosts-v2
NEXT_PUBLIC_LINK_ETHERSCAN=https://etherscan.io
